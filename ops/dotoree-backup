#!/bin/bash
# dotoree 일 1회 백업 → 로컬 약 7일 + S3 daily/ (수명 주기 30일 + 이전 버전 7일). ADR-050
# 정본은 저장소 ops/. 서버 설치 위치 /usr/local/sbin/dotoree-backup (root:root 700), 실행은 dotoree-backup.timer
# root 로 실행 (MySQL root = auth_socket, S3 = 인스턴스 역할 dotoree-prod-app-role. 키 파일 없음)
set -euo pipefail
umask 077

source /etc/dotoree/backup.env   # S3_BACKUP_BUCKET(식별자) — 저장소 밖, ADR-048

AWS=/snap/bin/aws                # systemd PATH 에 /snap/bin 이 없다
REGION=ap-northeast-2
DIR=/var/backups/dotoree
KEEP_DAYS=7                      # -mtime +7 이라 실제로는 7~8개 (ADR-050)
NAME="dotoree-$(date +%Y%m%d-%H%M%S).sql.gz"
OUT="$DIR/$NAME"

# 끝날 때 한 번 — 성공이든 실패든 CloudWatch 지표 dotoree/BackupOK 에 1(성공)·0(실패)을 남긴다 (ADR-051)
#   경보 두 개가 본다(us-east-1): 0 이 들어오면 바로 메일 · 24시간 동안 1 이 없으면(서버·타이머가 죽은 경우 포함) 메일
#   지표 쓰기 실패는 백업 결과를 바꾸지 않는다 — 로그만 남긴다
finish() {
  local rc=$?
  rm -f "$OUT.tmp"
  "$AWS" cloudwatch put-metric-data --region us-east-1 --namespace dotoree --metric-name BackupOK \
    --value "$([ "$rc" -eq 0 ] && echo 1 || echo 0)" || echo "metric put failed" >&2
}
trap finish EXIT

mysqldump --single-transaction --routines --triggers --events dotoree | gzip > "$OUT.tmp"
gzip -t "$OUT.tmp"
zcat "$OUT.tmp" | tail -1 | grep -q "^-- Dump completed" || { echo "backup FAILED: dump incomplete" >&2; exit 1; }
mv "$OUT.tmp" "$OUT"

# 업로드가 실패하면 여기서 멈춘다 — 로컬 정리(find)를 건너뛰어 옛 사본도 남는다
"$AWS" s3 cp "$OUT" "s3://$S3_BACKUP_BUCKET/daily/$NAME" --region "$REGION" --only-show-errors \
  || { echo "backup FAILED: upload (local copy kept: $OUT)" >&2; exit 1; }

find "$DIR" -name 'dotoree-*.sql.gz' -mtime +"$KEEP_DAYS" -delete
echo "backup ok: $OUT ($(stat -c %s "$OUT") bytes) -> s3 daily/$NAME"
