<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kyumin.dotoree.mapper.RefreshTokenMapper">

	<insert id="insertRefreshToken" parameterType="com.kyumin.dotoree.domain.RefreshToken">
		INSERT INTO refresh_tokens (
			family_id, user_num, token_hash, expires_at
		)
		VALUES (
			#{familyId}, #{userNum}, #{tokenHash}, #{expiresAt}
		)
	</insert>

	<!-- 재발급 — 쿠키 원문의 해시로 장부 한 줄. 줄만 가져온다: WHERE 는 token_hash 하나(UNIQUE 라 0 또는 1행)
	     폐기·만료 판정은 자바(RefreshTokenService)에서 — 폐기된 줄도 보여야 재사용 탐지가 된다 (ADR-055)
	     SELECT * — 도메인이 테이블과 1:1 이라 남는 칸이 없다(다른 매퍼와 같은 규칙) -->
	<select id="findByTokenHash" resultType="com.kyumin.dotoree.domain.RefreshToken">
		SELECT *
		FROM refresh_tokens
		WHERE token_hash = #{tokenHash}
	</select>

	<!-- 로테이션 — 찾은 줄(PK)을 폐기. REVOKED_YN · REVOKED_AT 은 같은 UPDATE 에서 (ADR-055). 시각은 자바가 잰 값
	     AND revoked_yn = 'N' — 동시 재발급이면 먼저 온 쪽만 1행, 늦은 쪽은 0행 → 새 카드가 두 장 생기지 않는다(살아 있는 건 하나) -->
	<update id="revokeToken">
		UPDATE refresh_tokens
		SET revoked_yn = 'Y', revoked_at = #{revokedAt}
		WHERE token_num = #{tokenNum}
		AND revoked_yn = 'N'
	</update>

	<!-- 재사용 탐지·유예 — 같은 family_id 중 살아 있는 줄을 한 번에 폐기 (ADR-055 선택 1·10)
	     AND revoked_yn = 'N' — 바뀐 줄 수 = 폐기 직전까지 살아 있던 줄 수. 0행 = 이미 전부 폐기됨 → 유예 ② 실패(서비스가 401)
	     "살아 있나 세기"와 "폐기"를 UPDATE 하나로 — SELECT COUNT 뒤 UPDATE 로 나누면 그 사이에 다른 요청이 끼어든다(check-then-act) -->
	<update id="revokeFamily">
		UPDATE refresh_tokens
		SET revoked_yn = 'Y', revoked_at = #{revokedAt}
		WHERE family_id = #{familyId}
		AND revoked_yn = 'N'
	</update>

	<!-- 전 세션 폐기 — 비번 변경·탈퇴. 같은 user_num 의 살아 있는 줄을 일행 가리지 않고 한 번에 (ADR-055 선택 16)
	     WHERE (user_num, revoked_yn) = V1 인덱스 IDX_TOKEN_USER_REVOKED 그대로 탄다
	     규칙 — 이 파일의 폐기 UPDATE 셋은 revoked_yn 과 revoked_at 을 항상 같이 채운다. 유예 판정이 getRevokedAt() 을 바로 써서 Y 인데 NULL 이면 NPE → 500
	            DB CHECK(V4)는 보류(2026-09-29) — 폐기 SQL 이 이 파일 밖에 생기면 다시 본다 -->
	<update id="revokeAllOfUser">
		UPDATE refresh_tokens
		SET revoked_yn = 'Y', revoked_at = #{revokedAt}
		WHERE user_num = #{userNum}
		AND revoked_yn = 'N'
	</update>

</mapper>
